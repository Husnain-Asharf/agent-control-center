{
  "name": "agent-control-center",
  "version": "0.5.0",
  "private": true,
  "description": "A desktop app for macOS, Linux and Windows to run and supervise Claude Code sessions, with git worktrees and tool-call approvals.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "ai-agents",
    "coding-agents",
    "agentic-coding",
    "tauri",
    "rust",
    "react",
    "desktop-app",
    "macos",
    "linux",
    "windows",
    "developer-tools",
    "git-worktree",
    "approvals"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "sidecars": "node scripts/sidecars.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
