    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "~7.0.0",
    "vite": "~8.3.0",
    "vitest": "5.1.1"
  }
